# --- Site identity (build-time) ---------------------------------------------

DOCS_SITE_URL=https://habitforge-docs.aoneahsan.com
# [REQUIRED] Absolute URL of the deployed site. Used in sitemap, JSON-LD,
# OG tags, RSS, and IndexNow. Trailing slash NOT required.

DOCS_BASE_URL=/
# [REQUIRED] Path prefix for the site. "/" for root deployment.

# --- Author identity --------------------------------------------------------

AUTHOR_NAME=Ahsan Mahmood
AUTHOR_EMAIL=aoneahsan@gmail.com
AUTHOR_URL=https://aoneahsan.com
AUTHOR_LINKEDIN=https://linkedin.com/in/aoneahsan
AUTHOR_GITHUB=https://github.com/aoneahsan
AUTHOR_NPM=https://npmjs.com/~aoneahsan

# --- Search engine submission (optional, used by IndexNow tooling) ---------

INDEXNOW_KEY=
# [OPTIONAL] 32-char hex key generated for IndexNow. When present, the file
# static/${INDEXNOW_KEY}.txt is created at build time and IndexNow ping
# scripts can use this key to push URL updates.
